{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "permissions": {
    "allow": [
      "Bash(npm create *)",
      "Bash(yes \"\")",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(npm view *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(lsof -nP -iTCP:5173 -iTCP:5174 -sTCP:LISTEN)",
      "Bash(kill 21164)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run format"
          },
          {
            "type": "command",
            "command": "npm run lint || exit 2"
          },
          {
            "type": "command",
            "command": "npm run typecheck || exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  }
}
